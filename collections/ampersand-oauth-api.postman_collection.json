          "id": "fea8472b-cde0-4c7c-bd09-8340296a30e8",
          "name": "Ampersand Generate OAuth Authorization URL",
          "request": {
            "name": "Ampersand Generate OAuth Authorization URL",
            "description": {
              "content": "Generate a URL for the browser to render to kick off OAuth flow. You can use this endpoint as an alternative to the [prebuilt UI components](https://docs.withampersand.com/embeddable-ui-components).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth-connect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"<string>\",\n  \"groupRef\": \"<string>\",\n  \"consumerRef\": \"<string>\",\n  \"provider\": \"<string>\",\n  \"groupName\": \"<string>\",\n  \"consumerName\": \"<string>\",\n  \"providerWorkspaceRef\": \"<string>\",\n  \"providerMetadata\": {\n    \"key_0\": {\n      \"value\": \"<string>\",\n      \"source\": \"<string>\",\n      \"displayName\": \"<string>\"\n    },\n    \"key_1\": {\n      \"value\": \"<string>\",\n      \"source\": \"<string>\",\n      \"displayName\": \"<string>\"\n    },\n    \"key_2\": {\n      \"value\": \"<string>\",\n      \"source\": \"<string>\",\n      \"displayName\": \"<string>\"\n    }\n  },\n  \"providerAppId\": \"<string>\",\n  \"enableCSRFProtection\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "b107d306-3ffc-42f3-8813-a95cc1a1417f",
