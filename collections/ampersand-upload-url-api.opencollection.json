{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ampersand public API Key Upload URL API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload URL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ampersand Generate a Signed URL to Upload a Zip File To.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withampersand.com/v1/generate-upload-url"
          },
          "docs": "Ampersand Generate a Signed URL to Upload a Zip File To."
        }
      ]
    }
  ],
  "bundled": true
}