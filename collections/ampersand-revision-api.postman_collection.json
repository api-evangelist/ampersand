          "name": "Ampersand Get a Hydrated Revision",
          "request": {
            "name": "Ampersand Get a Hydrated Revision",
            "description": {
              "content": "Returns the integration revision enriched with live field metadata from the consumer's connected SaaS instance, such as available fields, display names, and type for each object defined in the integration.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectIdOrName",
                "integrations",
                ":integrationId",
                "revisions",
                "{{revisionId}}:hydrate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "connectionId",
                  "value": "<string>",
                  "description": "(Required) The ID of the consumer's connection to the SaaS provider. This connection's credentials are used to fetch field metadata from the provider's API."
