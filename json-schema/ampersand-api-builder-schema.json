{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/ampersand/refs/heads/main/json-schema/ampersand-api-builder-schema.json",
  "title": "Builder",
  "description": "Builder schema from Ampersand API",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The builder ID.",
      "example": "builder-id-123"
    },
    "idpProvider": {
      "type": "string",
      "description": "The identity provider",
      "example": "clerk"
    },
    "idpRef": {
      "type": "string",
      "description": "ID used by the identity provider"
    },
    "createTime": {
      "type": "string",
      "description": "The time that the builder joined Ampersand.",
      "format": "date-time"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "primaryEmail": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "idpProvider",
    "idpRef",
    "createTime"
  ]
}